# Environment configuration for SAARTHI Access
PROJECT_NAME="SAARTHI Access"
ENV="development"
DEBUG=true

# Database (PostgreSQL 16 + PostGIS + pgRouting)
DATABASE_URL="postgresql://saarthi:saarthi_dev_pw@localhost:5432/saarthi_db"
TEST_DATABASE_URL="postgresql://saarthi:saarthi_dev_pw@localhost:5432/saarthi_test_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security & Staff JWT Auth
SECRET_KEY="saarthi_insecure_development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# S3 / MinIO Storage (Photos)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="saarthi-photos"
S3_REGION="us-east-1"
S3_SECURE=false

# External Providers (Leave empty or set keys; missing key shows "Not Configured")
# Vision AI Provider (openai, anthropic, gemini)
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o"

# SMS / IVR Provider (twilio, exotel)
SMS_PROVIDER="twilio"
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_PHONE_NUMBER=""

# Geographic Bounding Box for OSM Clip (e.g. Pune, India: min_lon,min_lat,max_lon,max_lat)
BBOX="73.70,18.40,74.05,18.65"
DEFAULT_WARD_CODE="PMC"
